{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Turborepo configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ui": {
      "type": "string",
      "enum": ["tui", "stream"]
    },
    "globalEnv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "globalDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "passThroughEnv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cache": {
            "type": "boolean"
          },
          "persistent": {
            "type": "boolean"
          },
          "interactive": {
            "type": "boolean"
          },
          "interruptible": {
            "type": "boolean"
          },
          "with": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "required": ["tasks"],
  "additionalProperties": true
}
